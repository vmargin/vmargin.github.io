{
  "name": "portfolio-v6",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "tsc -b && vite build && node scripts/generate-project-pages.mjs",
    "build:github-pages": "npm run build && node scripts/prepare-github-pages.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"docs/*.md\" README.md DESIGN.md index.html package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"docs/*.md\" README.md DESIGN.md index.html package.json tsconfig.json vite.config.ts",
    "typecheck": "tsc -b",
    "verify:content": "node --test scripts/content-contract.test.mjs scripts/showcase-contract.test.mjs",
    "verify:showcases": "node scripts/verify-showcases.mjs",
    "verify:browser": "node scripts/verify-portfolio.mjs",
    "verify:latest": "node scripts/verify-latest-updates.mjs",
    "verify:portrait": "node scripts/verify-portrait-layout.mjs",
    "verify:bulb": "node scripts/verify-bulb-interaction.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.60.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "zod": "^4.6.7"
  }
}
